{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tajkart:schemas:assessment-question:v1",
  "title": "Tajkart assessment question",
  "description": "A structured original assessment question with a stable skill and lesson mapping, prerequisite context, feedback, solution, verification evidence, and review state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "question", "subject", "skill_ids", "prerequisite_ids", "difficulty", "lesson_id",
    "answer_format", "accepted_answers", "hint", "solution", "explanation", "constraints",
    "common_mistakes", "provenance", "verification_method", "verification", "review_status"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "question": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "skill_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "lesson_id": {"description": "ID of the related lesson or guide resource.", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "answer_format": {"enum": ["integer", "decimal", "fraction", "text", "manual"]},
    "accepted_answers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0, "uniqueItems": true},
    "choices": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true},
    "hint": {"type": "string", "minLength": 1},
    "solution": {"type": "string", "minLength": 1},
    "explanation": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "common_mistakes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["original", "external-reference"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"}
      },
      "required": ["kind", "source_id"]
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"input": {"type": "string"}, "output": {"type": "string"}},
        "required": ["input", "output"]
      }
    },
    "verification_method": {"enum": ["substitution", "direct-evaluation", "special-case", "example-execution"]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["combine-coefficients", "evaluate-linear", "solve-linear", "classify-zero-coefficient", "fraction-sum", "fraction-conversion", "percentage-share", "unit-rate", "percentage-discount", "percentage-change", "statistics-summary", "python-output"]},
        "coefficients": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "terms": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}}, "minItems": 1},
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1},
        "expected_decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        "expected_percent": {"type": "number"},
        "decimal_terminates": {"type": "boolean"},
        "part_units": {"type": "integer", "minimum": 0},
        "whole_units": {"type": "integer", "minimum": 1},
        "total": {"type": "integer"},
        "count": {"type": "integer", "minimum": 1},
        "original_value": {"type": "integer"},
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "old_value": {"type": "integer"},
        "new_value": {"type": "integer"},
        "observations": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "expected_total": {"type": "integer"},
        "expected_mean": {"type": "number"},
        "expected_median": {"type": "number"},
        "coefficient": {"type": "integer"},
        "constant": {"type": "integer"},
        "variable_value": {"type": "integer"},
        "rhs": {"type": "integer"},
        "code": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string"},
        "answer_from_output": {"enum": ["stdout", "line-count"]}
      },
      "required": ["kind"]
    },
    "review_status": {"enum": ["pending", "technical-reviewed", "approved"]}
  },
  "allOf": [
    {"if": {"properties": {"answer_format": {"const": "manual"}}, "required": ["answer_format"]}, "then": {"properties": {"accepted_answers": {"maxItems": 0}}}},
    {"if": {"properties": {"answer_format": {"not": {"const": "manual"}}}, "required": ["answer_format"]}, "then": {"properties": {"accepted_answers": {"minItems": 1}}}},
    {"if": {"properties": {"verification_method": {"const": "substitution"}}, "required": ["verification_method"]}, "then": {"properties": {"verification": {"properties": {"kind": {"enum": ["solve-linear", "classify-zero-coefficient"]}}}}}},
    {"if": {"properties": {"verification_method": {"const": "direct-evaluation"}}, "required": ["verification_method"]}, "then": {"properties": {"verification": {"properties": {"kind": {"enum": ["combine-coefficients", "evaluate-linear", "fraction-sum", "fraction-conversion", "percentage-share", "unit-rate", "percentage-discount", "percentage-change", "statistics-summary"]}}}}}},
    {"if": {"properties": {"verification_method": {"const": "example-execution"}}, "required": ["verification_method"]}, "then": {"properties": {"verification": {"properties": {"kind": {"const": "python-output"}}, "required": ["kind", "code", "expected_output", "answer_from_output"]}}}}
  ]
}
